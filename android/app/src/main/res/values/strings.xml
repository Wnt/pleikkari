    <string name="preferences_decoder_low_latency_enabled_title">Low-latency decoder</string>
    <string name="preferences_decoder_low_latency_enabled_summary">Request reduced decoder buffering and fall back automatically if unsupported (re-connect required)</string>
	<string name="preferences_decoder_input_thread_enabled_title">Decoder input thread</string>
	<string name="preferences_decoder_input_thread_enabled_summary">Keep network receive independent from decoder input stalls; replaces an unconsumed frame with the latest one (re-connect required)</string>
    <string name="preferences_thread_priority_boost_enabled_title">Boost stream thread priority and affinity</string>
    <string name="preferences_thread_priority_boost_enabled_summary">Raise the priority and pin the network receive, decoder output, and video presenter threads to CPUs 4–7 (re-connect required)</string>
    <string name="preferences_performance_mode_enabled_title">Stream power-management hints</string>
    <string name="preferences_performance_mode_enabled_summary">Request sustained-performance mode and ADPF frame-budget hints on supported devices (ADPF requires Android 12+; experimental; reconnect required)</string>
    <string name="preferences_wifi_low_latency_lock_enabled_title">Wi-Fi low-latency lock</string>
    <string name="preferences_wifi_low_latency_lock_enabled_summary">Keep Wi-Fi in low-latency mode while streaming (high-performance mode before Android 10; experimental)</string>
    <string name="preferences_decoder_late_frame_recovery_enabled_title">Decoder late-frame recovery</string>
    <string name="preferences_decoder_late_frame_recovery_enabled_summary">Drop stale ready frames and request an IDR when five frames are backlogged (reconnect required)</string>
	<string name="preferences_video_pacing_enabled_title">Vsync-paced video presenter</string>
	<string name="preferences_video_pacing_enabled_summary">Pace decoded frames to display vsync with a dynamic de-jitter buffer (reconnect required)</string>
	<string name="preferences_video_pacing_high_refresh_enabled_title">Pace on high-refresh displays</string>
	<string name="preferences_video_pacing_high_refresh_enabled_summary">Allow timestamped frame release at 119 Hz and above (experimental; reconnect required)</string>
	<string name="preferences_video_dejitter_enabled_title">Arrival-based de-jitter policy</string>
	<string name="preferences_video_dejitter_enabled_summary">Schedule paced frames from receiver-ready time and measured arrival depth instead of the PTS timeline (experimental; reconnect required)</string>
	<string name="preferences_video_dejitter_half_rate_enabled_title">Adapt to 30 fps source cadence</string>
	<string name="preferences_video_dejitter_half_rate_enabled_summary">Use a doubled cadence-clock period when 30 fps content is detected inside a 60 fps stream (experimental; reconnect required)</string>
	<string name="preferences_video_dejitter_floor_ms_title">De-jitter depth floor</string>
	<string name="preferences_video_dejitter_cap_ms_title">De-jitter depth cap</string>
	<string name="preferences_video_dejitter_depth_ms_value">%d ms (1–256)</string>
	<string name="preferences_video_dejitter_queue_age_frames_title">De-jitter queue age</string>
	<string name="preferences_video_dejitter_queue_age_frames_value">%d frame periods (0 disables, max 10)</string>
	<string name="preferences_video_pacing_mode_title">Video pacing mode</string>
	<string name="preferences_video_pacing_mode_title_lowest_latency">Lowest latency</string>
	<string name="preferences_video_pacing_mode_title_balanced">Balanced</string>
	<string name="preferences_video_pacing_mode_title_smoothest">Smoothest</string>
	<string name="preferences_video_presenter_lead_title">Video presenter lead</string>
	<string name="preferences_video_presenter_lead_title_2ms">2 ms</string>
	<string name="preferences_video_presenter_lead_title_half_vsync">Half vsync period</string>
	<string name="preferences_video_recovery_strategy_title">Pacing recovery strategy</string>
	<string name="preferences_video_recovery_strategy_summary">What the presenter does when a queued frame is already late: flush the queue to the newest frame (default) or shift the timeline (reconnect required)</string>
	<string name="preferences_video_recovery_strategy_title_timeline_shift">Shift timeline</string>
	<string name="preferences_video_recovery_strategy_title_flush">Flush queue</string>
	<string name="preferences_video_pacing_bounded_age_enabled_title">Bound paced-frame age</string>
	<string name="preferences_video_pacing_bounded_age_enabled_summary">Drop queued head frames that are too old relative to the newest decoded frame (experimental; reconnect required)</string>
	<string name="preferences_video_presenter_nonblocking_producer_title">Non-blocking video producer</string>
	<string name="preferences_video_presenter_nonblocking_producer_summary">Drop the oldest queued frame instead of blocking the decoder output thread when the paced queue is full (experimental; reconnect required)</string>
	<string name="preferences_video_pacing_max_frame_age_periods_title">Maximum paced-frame age</string>
	<string name="preferences_video_pacing_max_frame_age_periods_value">%d frame periods (1–10)</string>
    <string name="preferences_packet_loss_max_percent_title">Packet loss reported max</string>
    <string name="preferences_packet_loss_max_percent_summary">Cap the packet loss reported to the console every 200ms (0-100). Lower values trade occasional artifacts for a steadier bitrate on lossy Wi-Fi.</string>
    <string name="preferences_packet_loss_max_percent_value">%d%%</string>
    <string name="preferences_adaptive_loss_report_title">Adaptive loss-report experiment</string>
    <string name="preferences_adaptive_loss_report_summary">Report real uncapped loss after sustained packet loss or jitter so the console can lower its target bitrate (experimental; reconnect required)</string>
    <string name="preferences_decoder_operating_rate_title">Decoder operating rate</string>
    <string name="preferences_decoder_operating_rate_summary">Explicit MediaCodec operating-rate from 0–4000 frames/s plus frame-rate = stream fps; 0 leaves the codec defaults (experiment; reconnect required)</string>
    <string name="preferences_decoder_operating_rate_value">%d (0 = codec default)</string>
    <string name="preferences_decoder_operating_rate_default_title">Decoder operating rate on default path</string>
    <string name="preferences_decoder_operating_rate_default_summary">Request operating-rate 960 and frame-rate = stream fps without requiring frame-index timestamps or pacing (ignored when an explicit operating rate is set; experiment; reconnect required)</string>
    <string name="preferences_decoder_operating_rate_auto_title">Auto decoder operating rate for frame-index timestamps</string>
    <string name="preferences_decoder_operating_rate_auto_summary">With frame-index timestamps on, request operating-rate 960 for the fastest measured Exynos decoder level (ignored when an explicit or default-path operating rate is set; reconnect required)</string>
    <string name="preferences_decoder_realtime_priority_title">Decoder realtime priority</string>
    <string name="preferences_decoder_realtime_priority_summary">Configure the decoder with priority = 0 (realtime) instead of leaving it unset (experiment; reconnect required)</string>
    <string name="preferences_decoder_qcom_vt_low_latency_title">Qualcomm low-latency decode (Oculus Go)</string>
    <string name="preferences_decoder_qcom_vt_low_latency_summary">Configure the Go\'s OMX.qcom decoder with vt-low-latency = 1, its video-call mode: frames come out in decode order, with no display-order hold (experiment; reconnect required)</string>
    <string name="preferences_video_timestamp_rate_hz_title">Frame-index timestamp rate</string>
    <string name="preferences_video_timestamp_rate_hz_summary">Timeline rate (Hz) used for frame-index video timestamps; 0 = stream fps (experiment; reconnect required)</string>
    <string name="preferences_video_timestamp_rate_hz_value">%d Hz (0 = stream fps)</string>
    <string name="preferences_takion_video_packet_reordering_disabled_title">Immediate video packet delivery</string>
    <string name="preferences_takion_video_packet_reordering_disabled_summary">Bypass the 16 ms network reorder queue and let frame FEC handle missing packets (re-connect required)</string>
    <string name="preferences_controller_input_coalescing_enabled_title">Vsync-paced controller input</string>
    <string name="preferences_controller_input_coalescing_enabled_summary">Merge controller updates into one native call per display frame (applies to the next stream)</string>
    <string name="preferences_gamepad_unbuffered_dispatch_enabled_title">Unbuffered gamepad dispatch</string>
    <string name="preferences_gamepad_unbuffered_dispatch_enabled_summary">Ask Android not to batch physical-controller joystick events on Android 11+, so an axis change reaches the coalescer as soon as it arrives instead of waiting for the next input batch</string>
    <string name="preferences_gamepad_trigger_fallback_enabled_title">Alternate gamepad trigger axes</string>
    <string name="preferences_gamepad_trigger_fallback_enabled_summary">Use brake/gas for L2/R2 when a controller reports trigger axes that stay at zero (applies to the next stream)</string>
    <string name="preferences_feedback_reduced_interval_enabled_title">Reduced feedback interval (experimental)</string>
    <string name="preferences_feedback_reduced_interval_enabled_summary">Send controller feedback state at most every 4ms instead of 8ms; untested on PS5, revert if it causes disconnects or dropped input (applies to the next stream)</string>
    <string name="preferences_stream_end_cause_probe_enabled_title">Explain console-side stream ends</string>
    <string name="preferences_stream_end_cause_probe_enabled_summary">When the console ends a stream, ask it on the local network whether it was taken over on the TV or went to rest, and say so on the home screen</string>
    <string name="preferences_feedback_stats_log_enabled_title">Log stream statistics (diagnostic)</string>
    <string name="preferences_feedback_stats_log_enabled_summary">Write one line per second to the session log with video, network, feedback, RTT, and audio statistics (applies to the next stream)</string>
    <string name="preferences_stream_diagnostics_overlay_enabled_title">In-stream diagnostics overlay</string>
    <string name="preferences_stream_diagnostics_overlay_enabled_summary">Show decoder, network, display, and pacing statistics over the stream at 1 Hz (applies to the next stream)</string>
    <string name="preferences_senkusha_fallback_notice_enabled_title">Notice when network probing fails</string>
    <string name="preferences_senkusha_fallback_notice_enabled_summary">Show a brief message when the pre-stream network probe fails and the stream starts with fallback MTU/RTT values instead (applies to the next stream)</string>
    <string name="stream_senkusha_fallback_notice">Network probe failed; using fallback network settings</string>
	<string name="preferences_audio_buffer_bursts_title">Audio output buffer bursts</string>
	<string name="preferences_audio_buffer_bursts_summary">Oboe output buffer depth in hardware bursts (0 keeps the device default; 0–16; applies to the next stream)</string>
