    <string name="go_vr_summary">Head-tracked cinema at 72 Hz; the Go Library opens straight into it. Turn off to use the Oculus TV screen.</string>
    <string name="go_vr_match_60hz_title">Match panel to stream (60 Hz)</string>
    <string name="go_vr_match_60hz_summary">Run the Go panel at 60 Hz when the stream is 60 fps, instead of 72 Hz.</string>
    <string name="go_vr_room_high_gpu_title">Higher GPU clock in rooms</string>
    <string name="go_vr_room_high_gpu_summary">Raise the Go GPU clock level from 2 to 4 while a cinema room is drawn, to cut stale frames at some battery and heat cost.</string>
    <string name="go_vr_frame_listener_thread_title">Cinema frame signal off the main thread</string>
    <string name="go_vr_frame_listener_thread_summary">Deliver the decoder\'s new-frame signal to the cinema on its own thread instead of the app\'s main thread, to latch more decoded frames in time.</string>
    <string name="go_vr_late_start_title">Cinema frames start late</string>
    <string name="go_vr_late_start_summary">Draw each cinema frame just before the headset takes it, instead of right after the last one, so it shows a newer video frame.</string>
