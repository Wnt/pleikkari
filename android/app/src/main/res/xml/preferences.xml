            app:summary="@string/preferences_gamepad_trigger_fallback_enabled_summary"
            app:defaultValue="false"
            app:icon="@drawable/ic_gamepad" />

        <SwitchPreference
            app:key="@string/preferences_feedback_reduced_interval_enabled_key"
            app:title="@string/preferences_feedback_reduced_interval_enabled_title"
            app:summary="@string/preferences_feedback_reduced_interval_enabled_summary"
            app:defaultValue="false"
            app:icon="@drawable/ic_gamepad" />

        <SwitchPreference
            app:key="@string/preferences_feedback_stats_log_enabled_key"
            app:title="@string/preferences_feedback_stats_log_enabled_title"
            app:summary="@string/preferences_feedback_stats_log_enabled_summary"
            app:defaultValue="false"
            app:icon="@drawable/ic_gamepad" />

        <SwitchPreference
            app:key="@string/preferences_stream_end_cause_probe_enabled_key"
            app:title="@string/preferences_stream_end_cause_probe_enabled_title"
            app:summary="@string/preferences_stream_end_cause_probe_enabled_summary"
            app:defaultValue="true"
            app:icon="@drawable/ic_fps" />

        <SwitchPreference
            app:key="@string/preferences_senkusha_fallback_notice_enabled_key"
            app:title="@string/preferences_senkusha_fallback_notice_enabled_title"
            app:summary="@string/preferences_senkusha_fallback_notice_enabled_summary"
            app:defaultValue="false"
            app:icon="@drawable/ic_fps" />

        <SwitchPreference
            app:key="@string/preferences_stream_diagnostics_overlay_enabled_key"
            app:title="@string/preferences_stream_diagnostics_overlay_enabled_title"
            app:summary="@string/preferences_stream_diagnostics_overlay_enabled_summary"
            app:defaultValue="false"
            app:icon="@drawable/ic_fps" />

		<EditTextPreference
