			app:defaultValue="2"
			app:dependency="@string/preferences_video_dejitter_enabled_key"
			app:icon="@drawable/ic_fps" />

		<ListPreference
			app:key="@string/preferences_video_pacing_mode_key"
			app:title="@string/preferences_video_pacing_mode_title"
			app:summary="%s"
			app:defaultValue="balanced"
			app:dependency="@string/preferences_video_pacing_enabled_key"
			app:icon="@drawable/ic_fps" />

		<ListPreference
			app:key="@string/preferences_video_presenter_lead_key"
