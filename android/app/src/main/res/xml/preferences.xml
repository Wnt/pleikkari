            app:defaultValue="false"
            app:icon="@drawable/ic_bitrate" />

        <SwitchPreference
            app:key="@string/preferences_decoder_late_frame_recovery_enabled_key"
            app:title="@string/preferences_decoder_late_frame_recovery_enabled_title"
            app:summary="@string/preferences_decoder_late_frame_recovery_enabled_summary"
            app:defaultValue="false"
            app:icon="@drawable/ic_fps" />

		<SwitchPreference
			app:key="@string/preferences_video_pacing_enabled_key"
			app:title="@string/preferences_video_pacing_enabled_title"
			app:summary="@string/preferences_video_pacing_enabled_summary"
			app:defaultValue="false"
			app:icon="@drawable/ic_fps" />

		<SwitchPreference
			app:key="@string/preferences_video_pacing_high_refresh_enabled_key"
			app:title="@string/preferences_video_pacing_high_refresh_enabled_title"
			app:summary="@string/preferences_video_pacing_high_refresh_enabled_summary"
			app:defaultValue="false"
			app:dependency="@string/preferences_video_pacing_enabled_key"
			app:icon="@drawable/ic_fps" />

		<SwitchPreference
			app:key="@string/preferences_video_dejitter_enabled_key"
			app:title="@string/preferences_video_dejitter_enabled_title"
			app:summary="@string/preferences_video_dejitter_enabled_summary"
			app:defaultValue="false"
			app:dependency="@string/preferences_video_pacing_enabled_key"
			app:icon="@drawable/ic_fps" />

		<SwitchPreference
			app:key="@string/preferences_video_dejitter_half_rate_enabled_key"
