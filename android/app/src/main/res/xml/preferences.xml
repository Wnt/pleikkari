			app:defaultValue="false"
			app:dependency="@string/preferences_video_pacing_enabled_key"
			app:icon="@drawable/ic_fps" />

		<SwitchPreference
			app:key="@string/preferences_video_presenter_nonblocking_producer_key"
			app:title="@string/preferences_video_presenter_nonblocking_producer_title"
			app:summary="@string/preferences_video_presenter_nonblocking_producer_summary"
			app:defaultValue="false"
			app:dependency="@string/preferences_video_pacing_enabled_key"
			app:icon="@drawable/ic_fps" />

		<EditTextPreference
			app:key="@string/preferences_video_pacing_max_frame_age_periods_key"
