            app:title="@string/preferences_decoder_operating_rate_default_title"
            app:summary="@string/preferences_decoder_operating_rate_default_summary"
            app:defaultValue="true"
            app:icon="@drawable/ic_fps" />

        <SwitchPreference
            app:key="@string/preferences_decoder_operating_rate_auto_key"
            app:title="@string/preferences_decoder_operating_rate_auto_title"
            app:summary="@string/preferences_decoder_operating_rate_auto_summary"
            app:defaultValue="true"
            app:icon="@drawable/ic_fps" />

        <EditTextPreference
            app:key="@string/preferences_decoder_operating_rate_key"
            app:title="@string/preferences_decoder_operating_rate_title"
            app:summary="@string/preferences_decoder_operating_rate_summary"
            app:icon="@drawable/ic_fps"/>

        <SwitchPreference
            app:key="@string/preferences_decoder_realtime_priority_key"
            app:title="@string/preferences_decoder_realtime_priority_title"
            app:summary="@string/preferences_decoder_realtime_priority_summary"
            app:defaultValue="false"
            app:icon="@drawable/ic_fps" />

        <!-- PLE-635: shown only on the Oculus Go (SettingsFragment); a no-op anywhere else. -->
        <SwitchPreference
            app:key="@string/preferences_decoder_qcom_go_profile_key"
            app:title="@string/preferences_decoder_qcom_go_profile_title"
            app:summary="@string/preferences_decoder_qcom_go_profile_summary"
            app:defaultValue="false"
            app:isPreferenceVisible="false"
            app:icon="@drawable/ic_fps" />

        <SwitchPreference
            app:key="@string/preferences_decoder_low_latency_enabled_key"
            app:title="@string/preferences_decoder_low_latency_enabled_title"
            app:summary="@string/preferences_decoder_low_latency_enabled_summary"
            app:defaultValue="false"
            app:icon="@drawable/ic_fps" />

		<SwitchPreference
			app:key="@string/preferences_decoder_input_thread_enabled_key"
			app:title="@string/preferences_decoder_input_thread_enabled_title"
			app:summary="@string/preferences_decoder_input_thread_enabled_summary"
			app:defaultValue="true"
			app:icon="@drawable/ic_fps" />

        <SwitchPreference
            app:key="@string/preferences_thread_priority_boost_enabled_key"
            app:title="@string/preferences_thread_priority_boost_enabled_title"
            app:summary="@string/preferences_thread_priority_boost_enabled_summary"
            app:defaultValue="false"
            app:icon="@drawable/ic_fps" />

        <SwitchPreference
            app:key="@string/preferences_performance_mode_enabled_key"
