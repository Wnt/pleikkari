            app:icon="@drawable/ic_fps"/>

        <ListPreference
            app:key="@string/preferences_display_refresh_rate_key"
            app:title="@string/preferences_display_refresh_rate_title"
            app:summary="%s"
            app:icon="@drawable/ic_fps"/>

        <EditTextPreference
            app:key="@string/preferences_bitrate_key"
            app:title="@string/preferences_bitrate_title"
            app:icon="@drawable/ic_bitrate"/>

        <ListPreference
            app:key="@string/preferences_codec_key"
            app:title="@string/preferences_codec_title"
            app:summary="%s"
            app:icon="@drawable/ic_codec"/>

        <SwitchPreference
            app:key="@string/preferences_real_video_timestamps_key"
            app:title="@string/preferences_real_video_timestamps_title"
            app:summary="@string/preferences_real_video_timestamps_summary_synthetic"
            app:defaultValue="false"
            app:icon="@drawable/ic_fps" />

        <EditTextPreference
            app:key="@string/preferences_video_timestamp_rate_hz_key"
            app:title="@string/preferences_video_timestamp_rate_hz_title"
            app:summary="@string/preferences_video_timestamp_rate_hz_summary"
            app:dependency="@string/preferences_real_video_timestamps_key"
            app:icon="@drawable/ic_fps"/>

        <SwitchPreference
