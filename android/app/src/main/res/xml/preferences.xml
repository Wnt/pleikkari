            app:title="@string/preferences_controller_input_coalescing_enabled_title"
            app:summary="@string/preferences_controller_input_coalescing_enabled_summary"
            app:defaultValue="false"
            app:icon="@drawable/ic_gamepad" />

        <SwitchPreference
            app:key="@string/preferences_gamepad_unbuffered_dispatch_enabled_key"
            app:title="@string/preferences_gamepad_unbuffered_dispatch_enabled_title"
            app:summary="@string/preferences_gamepad_unbuffered_dispatch_enabled_summary"
            app:defaultValue="false"
            app:icon="@drawable/ic_gamepad" />

        <SwitchPreference
            app:key="@string/preferences_gamepad_trigger_fallback_enabled_key"
